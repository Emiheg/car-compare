# Docker host ports. The container ports stay fixed in compose.yaml.
NEXT_FRONTEND_PORT=3000
FIREBASE_EMULATOR_UI_PORT=4000
FIREBASE_FIRESTORE_PORT=8080
FIREBASE_AUTH_PORT=9099

# Firebase development configuration
NEXT_PUBLIC_FIREBASE_API_KEY=local-dev-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=car-compare
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=car-compare.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=local-dev-sender
NEXT_PUBLIC_FIREBASE_APP_ID=local-dev-app
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# Statens vegvesen API key
SVV_API_KEY=